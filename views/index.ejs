<!doctype html>
<html lang="en">
  <head>
    <%- include('./partials/header'); %>
    <style>
      /* ===========================
   WEEK MOVERS CARD
   =========================== */

      .movers-container {
        width: min(100%, 760px);
        margin: 0 auto;
        background: #fff;
        border: 2px solid #1b4332;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.12);
      }

      .movers-header {
        background: linear-gradient(135deg, #1b4332, #2d6a4f);
        color: #fff;
        text-align: center;
        padding: 0.85rem 1rem;
      }

      .movers-title {
        font-size: clamp(1rem, 2vw, 1.35rem);
        font-weight: 700;
        line-height: 1.3;
      }

      .movers-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        padding: 1rem;
      }

      .mover-panel {
        background: #f8faf8;
        border: 1px solid #d7e6d7;
        border-radius: 10px;
        padding: 0.85rem;
      }

      .panel-title {
        text-align: center;
        font-size: clamp(0.95rem, 1.4vw, 1.15rem);
        font-weight: 700;
        margin-bottom: 0.75rem;
        color: #1b4332;
      }

      .mover-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: clamp(0.35rem, 1vw, 0.6rem) 0;
        border-bottom: 1px solid #ececec;
      }

      .mover-row:last-child {
        border-bottom: none;
      }

      .mover-name {
        font-size: clamp(0.9rem, 1.1vw, 1.05rem);
        font-weight: 600;
        line-height: 1.25;
      }

      .trend-up,
      .trend-down {
        font-size: clamp(1rem, 1.1rem, 1.25rem);
        font-weight: 700;
        min-width: 3rem;
        text-align: right;
      }

      .trend-up {
        color: #198754;
      }

      .trend-down {
        color: #dc3545;
      }

      /* ===========================
   TABLET
   =========================== */

      @media (max-width: 768px) {
        .movers-grid {
          gap: 0.75rem;
          padding: 0.75rem;
        }

        .mover-panel {
          padding: 0.75rem;
        }
      }

      /* ===========================
   PHONE
   =========================== */

      @media (max-width: 576px) {
        .movers-grid {
          grid-template-columns: 1fr;
        }

        .movers-title {
          font-size: 1rem;
        }

        .panel-title {
          margin-bottom: 0.5rem;
        }

        .mover-row {
          padding: 0.45rem 0;
        }
      }
    </style>
  </head>

  <body>
    <%- include('./partials/navbar'); %>

    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-W9Q82T2S"
        height="0"
        width="0"
        style="display: none; visibility: hidden"
      ></iframe>
    </noscript>

    <!-- MAIN -->
    <div class="main-wrapper">
      <!-- HERO LOGO -->

      <!-- CONTENT -->

      <div style="margin: 0 auto" class="winners">
        <div class="movers-container">
          <div class="movers-header">
            <div class="movers-title">
              Week <%= currentWeek.week_number %> (<%= currentWeek.displayDate
              %>) Movers
            </div>
          </div>

          <div class="movers-grid">
            <!-- MOVING UP -->
            <div class="mover-panel">
              <div class="panel-title">📈 Moving Up</div>

              <% biggestUp.forEach((player, idx) => { %>
              <div class="mover-row <%= idx === 0 ? 'top-mover' : '' %>">
                <span class="mover-name">
                  <%= player.player_name.split(',')[1].trim() %> <%=
                  player.player_name.split(',')[0] %>
                </span>

                <span class="trend-up">▲ +<%= player.delta %></span>
              </div>
              <% }) %>
            </div>

            <!-- MOVING DOWN -->
            <div class="mover-panel">
              <div class="panel-title">📉 Moving Down</div>

              <% biggestDown.forEach((player, idx) => { %>
              <div class="mover-row <%= idx === 0 ? 'top-faller' : '' %>">
                <span class="mover-name">
                  <%= player.player_name.split(',')[1].trim() %> <%=
                  player.player_name.split(',')[0] %>
                </span>

                <span class="trend-down">▼ -<%= player.delta %></span>
              </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FOOTER -->
    <%- include('./partials/footer'); %>
    <%- include('./partials/scripts'); %>
  </body>
</html>
