<link href="/assets/css/navbar.css" rel="stylesheet" />
<div class="hero-wrapper">
  <img src="/images/bottoms-up-header.webp" alt="Bottoms Up Golf League" class="hero-image" loading="eager"
    fetchpriority="high" width="1200" height="300" />
</div>
<nav id="auto-scroll" class="navbar navbar-expand-xl bg-body-tertiary">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center" href="/">
