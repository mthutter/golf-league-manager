          <ul class="dropdown-menu">
            <!-- UPDATED RESULTS SUBHEADER -->
            <li>
              <h6 class="dropdown-header text-uppercase fw-bold text-success text-center">League Analytics</h6>
            </li>
            <li><a class="dropdown-item" href="/scores/standings">Standings</a></li>
            <li><a class="dropdown-item" href="/skins">Skins</a></li>
            <li><a class="dropdown-item" href="/handicaps">Handicap History</a></li>
          </ul>
        </li>
         <li class="nav-item">
          <a class="nav-link px-3" href="/course">Course</a>
        </li>
         <li class="nav-item">
          <a class="nav-link px-3" href="/weather">Weather</a>
        </li>
        <!-- PRIVATE MEMBER NAVIGATION LINKS -->
        <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
       
        <li class="nav-item">
          <a class="nav-link px-3" href="/blog">Blog Page</a>
        </li>
        <li class="nav-item">
          <a class="nav-link px-3" href="/players">Members</a>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle px-3" href="#" role="button" data-bs-toggle="dropdown"
            aria-expanded="false"> Media </a>
          <ul class="dropdown-menu">
            <!-- UPDATED MEDIA SUBHEADERS -->
            <li>
              <h6 class="dropdown-header text-uppercase fw-bold text-success text-center">Photo Galleries</h6>
            </li>
            <li><a class="dropdown-item" href="/images/2024">📷 2024 Images</a></li>
            <li><a class="dropdown-item" href="/images/2025">📷 2025 Images</a></li>
            <li><a class="dropdown-item" href="/images/2026">📷 2026 Images</a></li>
            <li>
              <hr class="dropdown-divider" />
            </li>
            <li>
              <h6 class="dropdown-header text-uppercase fw-bold text-success text-center">Video "Highlights"</h6>
            </li>
            <li><a class="dropdown-item" href="/videos/2024">📹 2024 Videos</a></li>
            <li><a class="dropdown-item" href="/videos/2025">📹 2025 Videos</a></li>
            <li><a class="dropdown-item" href="/videos/2026">📹 2026 Videos</a></li>
          </ul>
        </li>
        <% } %>
