            <li>
              <h6 class="dropdown-header text-uppercase fw-bold text-muted text-center">System & Settings</h6>
            </li>
            <li><a class="dropdown-item" href="/admin">Admin Tools</a></li>
            <li><a class="dropdown-item" href="/players/system-users">System Users</a></li>
            <li><a class="dropdown-item" href="/admin/security/blacklist">IP Blacklist</a></li>
            <li><a class="dropdown-item disabled" href="#">Finance Tools <span
                  class="badge bg-light text-dark">Future</span></a></li>
          </ul>
        </li>
        <% } %>
        <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
        <!-- Visible to both Admins and Members when signed in -->
        <li class="nav-item">
          <a class="nav-link px-3" href="/players/profile">My Profile</a>
        </li>
        <li class="nav-item">
          <a class="nav-link px-3" href="/logout">Sign Out</a>
        </li>
        <% } else { %>
        <li class="nav-item">
          <a class="nav-link px-3" href="/login">Sign In</a>
        </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>