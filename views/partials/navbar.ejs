            <!-- Add dropdown-menu-end so it opens cleanly on the right -->
            <!-- CATEGORY 1: WEEKLY DATA ENTRY -->
            <li>
              <h6 class="dropdown-header text-uppercase fw-bold text-success text-center">Weekly Scoring</h6>
