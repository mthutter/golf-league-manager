            <li>
              <h6 class="dropdown-header text-uppercase fw-bold text-success text-center">Roster Management</h6>
            </li>
            <li><a class="dropdown-item" href="/players/new">Add Player</a></li>
            <li><a class="dropdown-item" href="/players">Active Members</a></li>
            <li><a class="dropdown-item" href="/players/inactive">Inactive Members</a></li>
            <li>
              <hr class="dropdown-divider" />
            </li>
            <!-- CATEGORY 3: LEAGUE COMMUNICATON -->
            <li>
              <h6 class="dropdown-header text-uppercase fw-bold text-success text-center">Communications</h6>
            </li>
            <li><a class="dropdown-item" href="/email/admin">E-Mail Form</a></li>
            <li><a class="dropdown-item" href="/blog/new">Blog Post</a></li>
            <li><a class="dropdown-item" href="/text/admin">Text Form<span
