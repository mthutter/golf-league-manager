<!-- 1. Let the browser handle script delivery cleanly and synchronously via your production CNAME -->
<script
  type="text/javascript"
  crossorigin="anonymous"
  defer
  src="https://t.bottoms-up-cos.org/static/array.js"
  crossorigin="anonymous"
></script>

<!-- 2. Execute initialization instantly with zero DOM manipulation overhead -->
<script>
  (function () {
    // Safety check to ensure the file above parsed correctly
    if (!window.posthog || !window.posthog.init) {
      console.warn("⚠️ PostHog library not fully loaded in memory yet.");
      return;
    }

    // Determine host configuration dynamically based on the current machine
    var isLocal =
      window.location.hostname === "localhost" ||
      window.location.hostname === "127.0.0.1";

    // FIXED: Local requests go straight to PostHog ingestion; prod uses your proxy CNAME
    var finalHost = isLocal
      ? "https://us.posthog.com"
      : "https://t.bottoms-up-cos.org";

    window.posthog.init("phc_sv3aBkEY4DE4wejGWfMHfNYxCUpDBxBc6iVRsJu7Q47t", {
      api_host: finalHost, // FIXED: Now uses the dynamic finalHost variable
      ui_host: "https://us.posthog.com", // CORRECT: Pointed to the main web app
      persistence: "cookie",
      session_recording: {},
      capture_exceptions: {
        capture_unhandled_errors: true,
        capture_unhandled_rejections: true,
        capture_console_errors: true,
      },     
      // Turn off payload compression locally so you can read data in your Network tab
      disable_compression: isLocal,
      loaded: function (ph) {
        if (isLocal) {
          ph.debug();
          console.log("🚀 POSTHOG:", finalHost);
        }
      },
    });
  })();
</script>
