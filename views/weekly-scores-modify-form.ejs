<!doctype html>
<html lang="en">

<head>
    <%- include('partials/header'); %>

    
</head>

<body>
    <%- include('partials/navbar'); %>
    <div class="main-wrapper">
        <div class="page-header text-center py-4">
            <h1>Modify Weekly Scores</h1>
            <p>Bottoms Up Golf League • 2026 Season</p>
        </div>
        <div class="container mb-4">
            <div class="card score-card">
                <div class="card-header">Modify League Score Record</div>
                <div class="card-body">
                    <form method="POST" action="/scores/update/<%= scoreRecord.score_id %>">

                        <!-- League / Player Info -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Week</label>
                                <input type="text" class="form-control" value="Week <%= scoreRecord.week_number %>" disabled />
                                <input type="hidden" name="weekId" value="<%= scoreRecord.week_id %>" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold"> Player </label>
                                <input type="text" class="form-control" value="<%= scoreRecord.name_last %>, <%= scoreRecord.name_first %>" disabled />
                                <input type="hidden" name="memberId" value="<%= scoreRecord.member_id %>" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Skins Game</label>
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" name="skins_entered" id="skinsEntered" value="1" <%= scoreRecord.skins_entered ? 'checked' : '' %> />
                                    <label class="form-check-label" for="skinsEntered"> Entered Skins </label>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold"> CTP Points </label>
                                <select class="form-select" name="ctp_points">
                                    <option value="0" <%= scoreRecord.ctp_points == 0 ? 'selected' : '' %>>0</option>
                                    <option value="1" <%= scoreRecord.ctp_points == 1 ? 'selected' : '' %>>1</option>
                                    <option value="2" <%= scoreRecord.ctp_points == 2 ? 'selected' : '' %>>2</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Birdie Points (Gross)</label>
                                <input class="form-control" type="number" id="birdiePoints" name="birdie_points" readonly value="<%= scoreRecord.birdie_points || 0 %>" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Player Handicap</label>
                                <input type="number" id="handicap" class="form-control" name="handicap" value="<%= scoreRecord.handicap_used %>" disabled />
                                <input type="hidden" name="handicap" value="<%= scoreRecord.handicap_used %>" />
                            </div>
                        </div>
                        <!-- Score Table -->
                        <div class="table-responsive">
                            <table class="table table-bordered align-middle">
                                <thead class="table-success">
                                    <tr>
                                        <th>Hole</th>
                                        <% holes.forEach(hole => { %>
                                        <th class="hole-header"><%= hole.hole_number %></th>
                                        <% }) %>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Par Row -->
                                    <tr>
                                        <th class="table-light">Par</th>
                                        <% holes.forEach(hole => { %>
                                        <td><%= hole.par_men %></td>
                                        <% }) %>
                                        <td class="total-box">
                                            <%= holes.reduce((sum, hole) => sum + hole.par_men, 0) %>
                                        </td>
                                    </tr>
                                    <!-- Handicap Row -->
                                    <tr>
                                        <th class="table-light">Handicap</th>
                                        <% holes.forEach(hole => { %>
                                        <td><%= hole.handicap_men %></td>
                                        <% }) %>
                                        <td></td>
                                    </tr>
                                    <!-- Score Entry Row -->
                                    <tr>
                                        <th class="table-light">Score (Gross)</th>
                                        <% holes.forEach((hole, index) => { %>
                                        <td>
                                            <input type="number" min="1" max="15" name="gross<%= hole.hole_number %>" class="form-control score-input" data-index="<%= index + 1 %>" data-holehcp="<%= hole.handicap_men %>" data-par="<%= hole.par_men %>" value="<%= scoreRecord['gross' + hole.hole_number] || '' %>" required />
                                        </td>
                                        <% }) %>
                                        <td class="total-box">
                                            <span id="grossTotal">0</span>
                                        </td>
                                    </tr>
                                    <!-- Dynamic Net Row -->
                                    <tr>
                                        <th class="table-light">Score (Net)</th>
                                        <% holes.forEach((hole, index) => { %>
                                        <td id="net<%= index + 1 %>"></td>
                                        <% }) %>
                                        <td class="total-box">
                                            <span id="netTotal">0</span>
                                        </td>
                                    </tr>
                                    <!-- Dynamic Points Row -->
                                    <tr>
                                        <th class="table-light">Points</th>
                                        <% holes.forEach((hole, index) => { %>
                                        <td id="pts<%= index + 1 %>"></td>
                                        <% }) %>
                                        <td class="total-box">
                                            <span id="pointsTotal">0</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-4 d-flex justify-content-end gap-2">
                            <a href="/scores/weekly/<%= scoreRecord.week_id %>" class="btn btn-outline-secondary btn-save d-flex align-items-center"> Cancel </a>
                            <button type="submit" class="btn btn-success btn-save"> Update Scores </button>
                        </div>
                        <input type="hidden" name="gross_total" id="grossTotalInput" />
                        <input type="hidden" name="net_total" id="netTotalInput" />
                        <input type="hidden" name="stableford_total" id="pointsTotalInput" />
                    </form>
                </div>
            </div>
        </div>
    </div>
    <%- include('partials/footer'); %>
    <%- include('partials/scripts'); %>

    <script>
        function handicapStrokes(playerHandicap, holeHandicap) {
            const nineHoleHandicap = Math.max(0, Number(playerHandicap) || 0);
            const holeStrokeIndex = ((Number(holeHandicap) - 1) % 9) + 1;
            const baseStrokes = Math.floor(nineHoleHandicap / 9);
            const remainingStrokes = nineHoleHandicap % 9;
            return baseStrokes + (holeStrokeIndex <= remainingStrokes ? 1 : 0);
        }

        function stablefordPoints(net, par) {
            const diff = net - par;
            if (diff >= 2) return 0;
            if (diff === 1) return 1;
            if (diff === 0) return 2;
            if (diff === -1) return 3;
            if (diff === -2) return 4;
            return 5;
        }

        function calculateCard() {
            let birdiePoints = 0;
            const handicap = parseInt(document.getElementById("handicap").value) || 0;
            let grossTotal = 0;
            let netTotal = 0;
            let pointsTotal = 0;

            document.querySelectorAll(".score-input").forEach((input) => {
                const cellIndex = input.dataset.index;
                const gross = parseInt(input.value) || 0;
                const holeHcp = parseInt(input.dataset.holehcp);
                const par = parseInt(input.dataset.par);

                if (gross) {
                    if (gross <= par - 1) {
                        birdiePoints++;
                    }
                    const strokes = handicapStrokes(handicap, holeHcp);
                    const net = gross - strokes;
                    const points = stablefordPoints(net, par);

                    document.getElementById(`net${cellIndex}`).textContent = net;
                    document.getElementById(`pts${cellIndex}`).textContent = points;

                    grossTotal += gross;
                    netTotal += net;
                    pointsTotal += points;
                } else {
                    document.getElementById(`net${cellIndex}`).textContent = "";
                    document.getElementById(`pts${cellIndex}`).textContent = "";
                }
            });

            document.getElementById("grossTotal").textContent = grossTotal;
            document.getElementById("netTotal").textContent = netTotal;
            document.getElementById("pointsTotal").textContent = pointsTotal;

            document.getElementById("birdiePoints").value = birdiePoints;
            document.getElementById("grossTotalInput").value = grossTotal;
            document.getElementById("netTotalInput").value = netTotal;
            document.getElementById("pointsTotalInput").value = pointsTotal;
        }

        document.querySelectorAll(".score-input").forEach((input) => {
            input.addEventListener("input", calculateCard);
        });

        document.getElementById("skinsEntered").addEventListener("change", calculateCard);

        document.addEventListener("DOMContentLoaded", () => {
            calculateCard();
        });
    </script>
</body>

</html>