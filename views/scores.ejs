<!doctype html>
<html lang="en">

<head>
    <%- include('partials/header'); %>
    
</head>

<body>
    <%- include('partials/navbar'); %>

    <div class="main-wrapper">
        <!-- Header Banner -->
        <div class="container">
            <div class="page-header">
                <h1>Weekly Scores</h1>
                <p>Bottoms Up Golf League • 2026 Season</p>
            </div>
        </div>

        <!-- Scores Performance Dashboard Layout -->
        <div class="container my-4">
            <div class="card shadow-sm scores-table-card">
                <!-- Sleek matching dark green card header block -->
                <div class="card-header text-white py-3" style="background-color: #1b4332">
                    <h5 class="card-title mb-0 fw-bold">All Performance Records</h5>
                    <small class="text-white-50">Complete hole-by-hole registry index of official matching season
                        history outputs.</small>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle text-center mb-0 league-table compact-pixel-table table-hover">
                        <thead>
                            <tr>
                                <th style="width: 1%">Week</th>
                                <th style="width: 1%">Member ID</th>
                                <th style="width: 1%">Handicap Used</th>
                                <th style="width: 1%">Hole 1</th>
                                <th style="width: 1%">Hole 2</th>
                                <th style="width: 1%">Hole 3</th>
                                <th style="width: 1%">Hole 4</th>
                                <th style="width: 1%">Hole 5</th>
                                <th style="width: 1%">Hole 6</th>
                                <th style="width: 1%">Hole 7</th>
                                <th style="width: 1%">Hole 8</th>
                                <th style="width: 1%">Hole 9</th>
                                <th style="width: 1%">Gross Total</th>
                                <th style="width: 1%">Net Total</th>
                                <th style="width: 1%">Points Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% scores.forEach(score => { %>
                            <tr>
                                <td class="fw-bold bg-light players nowrap-cell">
                                    <%= score.week_id %>
                                </td>
                                <td class="players nowrap-cell"><%= score.member_id %></td>
                                <td class="players nowrap-cell">
                                    <%= score.handicap_used %>
                                </td>
                                <td class="players nowrap-cell"><%= score.gross1 %></td>
                                <td class="players nowrap-cell"><%= score.gross2 %></td>
                                <td class="players nowrap-cell"><%= score.gross3 %></td>
                                <td class="players nowrap-cell"><%= score.gross4 %></td>
                                <td class="players nowrap-cell"><%= score.gross5 %></td>
                                <td class="players nowrap-cell"><%= score.gross6 %></td>
                                <td class="players nowrap-cell"><%= score.gross7 %></td>
                                <td class="players nowrap-cell"><%= score.gross8 %></td>
                                <td class="players nowrap-cell"><%= score.gross9 %></td>
                                <td class="fw-bold players nowrap-cell">
                                    <%= score.gross_total %>
                                </td>
                                <td class="fw-bold players nowrap-cell">
                                    <%= score.net_total %>
                                </td>
                                <td class="fw-bold text-success pe-3 players nowrap-cell">
                                    <%= score.stableford_total %>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/scripts'); %>
</body>

</html>