<!doctype html>
<html lang="en">
  <head>
    <%- include('partials/header'); %>

    
  </head>

  <body>
    <%- include('partials/navbar'); %>
    <!-- HERO -->
    <div class="main-wrapper">
      <div class="gallery-header">
        <h1>Add Player Form</h1>
        <p>Bottoms Up Golf League • 2026 Season</p>
      </div>

      <!-- FORM CARD -->
      <div class="player-form-card">
        <form action="/players" method="POST">
          <!-- PLAYER INFO -->
          <div class="form-section">
            <h3>Player Information</h3>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">First Name <span style="color: red">*</span></label>
                <input type="text" name="name_first" class="form-control" placeholder="Enter first name" required />
              </div>
              <div class="col-md-6">
                <label class="form-label">Last Name <span style="color: red">*</span></label>
                <input type="text" name="name_last" class="form-control" placeholder="Enter last name" required />
              </div>
              <div class="col-md-6">
                <label class="form-label">Year Joined</label>
                <div class="select-wrapper">
                  <select name="year_joined">
                    <option value="2024">2024</option>
                    <option value="2025">2025</option>
                    <option value="2026" selected>2026</option>
                  </select>
                </div>
              </div>
              <div class="col-md-6">
                <label class="form-label">Sex (for hole handicaps)<span style="color: red"> *</span></label>
                <div class="select-wrapper">
                  <select name="sex">
                    <option value="M">M</option>
                    <option value="F">F</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- CONTACT -->
          <div class="form-section">
            <h3>Contact Information</h3>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Email Address <span style="color: red">*</span></label>
                <input type="email" name="e_mail" class="form-control" placeholder="player@email.com" required />
              </div>
              <div class="col-md-6">
                <label class="form-label">Phone Number <span style="color: red">*</span></label>
                <input type="tel" name="phone" class="form-control" placeholder="(555) 555-5555" maxlength="14" required oninput="formatPhoneNumber(this)" />
              </div>
            </div>
          </div>

          <!-- LEAGUE -->
          <div class="form-section">
            <h3>League Settings</h3>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Active <span style="color: red">*</span></label>
                <div class="select-wrapper">
                  <select name="status">
                    <option selected>Yes or No</option>
                    <option>Yes</option>
                    <option>No</option>
                  </select>
                </div>
              </div>
              <div class="col-md-6">
                <label class="form-label">Status <span style="color: red">*</span></label>
                <div class="select-wrapper">
                  <select name="type">
                    <option selected>Regular or Substitute</option>
                    <option>Regular</option>
                    <option>Substitute</option>
                  </select>
                </div>
              </div>
            </div>
          </div>
          <!-- ROLES -->
          <div class="form-section">
            <h3>Assigned Roles</h3>
            <div class="d-flex gap-4">
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="roles" value="Member" id="roleMember" checked />
                <label class="form-check-label" for="roleMember">Member</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="roles" value="Admin" id="roleAdmin" />
                <label class="form-check-label" for="roleAdmin">Admin</label>
              </div>
            </div>
          </div>
          <!-- SUBMIT -->
          <div class="text-center mt-4">
            <button type="submit" class="btn btn-submit-player">Add Player</button>
          </div>
        </form>
      </div>
    </div>

    <%- include('partials/scripts'); %>
    <script>
      // 1. Formats the input value reactively as the user types
      function formatPhoneNumber(input) {
        let value = input.value.replace(/\D/g, "");
        if (value.length > 10) value = value.slice(0, 10);
        if (value.length >= 7) input.value = `(${value.slice(0, 3)}) ${value.slice(3, 6)}-${value.slice(6)}`;
        else if (value.length >= 4) input.value = `(${value.slice(0, 3)}) ${value.slice(3)}`;
        else if (value.length > 0) input.value = `(${value}`;
      }

      // 2. Formats any browser auto-filled numbers upon page load
      window.addEventListener("DOMContentLoaded", () => {
        const phoneInput = document.querySelector('input[name="phone"]');
        if (phoneInput && phoneInput.value) {
          formatPhoneNumber(phoneInput);
        }
      });
    </script>
  </body>
</html>
