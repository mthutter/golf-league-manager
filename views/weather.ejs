<!doctype html>
<html lang="en">
  <head>
    <%- include('./partials/header'); %>
    <style>
      /* Ensure the main page structure fills the available vertical space between Navbar and Footer */
      html,
      body {
        height: 100%;
        margin: 0;
      }
      body {
        display: flex;
        flex-direction: column;
      }
      /* Force the main content area to expand and flexbox center its children */
      .main-wrapper {
        flex: 1 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        box-sizing: border-box;
      }
      .gallery-header {
        text-align: center;
        margin-bottom: 1.5rem;
      }

      /* =========================== DASHBOARD LAYOUT GRID =========================== */
      .weather-dashboard {
        display: flex;
        flex-direction: row;
        gap: 1.5rem;
        width: 100%;
        max-width: 1200px;
        align-items: stretch; /* Vertically locks both heights together */
      }

      /* =========================== CENTERED RADAR FRAME =========================== */
      .radar-outer-container {
        flex: 1; /* Automatically expands to consume all available desktop width */
        height: 550px;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
        border: 2px solid #1b4332;
        background: #fff;
      }
      .radar-frame {
        width: 100%;
        height: 100%;
        border: none;
        display: block;
      }

      /* =========================== MATCHED WEATHER WIDGET CARD =========================== */
      .weather-widget-container {
        width: 100%;
        max-width: 300px; /* FIX: Reduced from 340px to hug the 300px widget framework exactly */
        height: 550px;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
        border: 2px solid #1b4332;
        background: #67676c; /* FIX: Changed from #fff to match the widget header shade */
        position: relative;
        flex-shrink: 0;
      }

      /* Ensure footer pushes down elegantly */
      footer {
        flex-shrink: 0;
      }

      /* =========================== RESPONSIVE BREAKPOINTS =========================== */
      @media (max-width: 992px) {
        .weather-dashboard {
          flex-direction: column;
          align-items: center;
        }
        .radar-outer-container {
          width: 100%;
          max-width: 800px;
          height: 400px; /* Shrinks map height on tablet displays */
        }
        .weather-widget-container {
          width: 100%;
          max-width: 800px; /* Relaxes constraints on tablet stack to fill row */
          height: auto;
          min-height: 150px;
        }
      }
      @media (max-width: 576px) {
        .radar-outer-container {
          height: 350px; /* Shrinks map height further on small phones */
        }
      }
    </style>
  </head>
  <body>
    <%- include('./partials/navbar'); %>

    <!-- MAIN VIEWPORT CONTAINER -->
    <div class="main-wrapper">
      <div class="gallery-header">
        <h1>Local Weather</h1>
        <p>Bottoms Up Golf League • 2026 Season</p>
      </div>

      <!-- Combined Weather Layout Grid -->
      <div class="weather-dashboard">
        <!-- 1. Windy Radar Frame Container -->
        <div class="radar-outer-container">
          <iframe
            class="radar-frame"
            src="https://embed.windy.com/embed2.html?lat=38.8576&lon=-104.7171&zoom=11&level=surface&overlay=radar&product=radar&menu=&message=true&marker=true&calendar=now&pressure=&type=map&location=coordinates&metricWind=mph&metricTemp=%C2%B0F&radarRange=-1"
            allowfullscreen
          ></iframe>
        </div>

        <!-- 2. Weather Widget Container -->
        <div class="weather-widget-container" style="height: 550px">
          <a
            class="weatherwidget-io"
            href="https://forecast7.com/en/38d86n104d70/80915/"
            data-label_1="COLORADO SPRINGS"
            data-label_2="WEATHER"
            data-theme="weather_one"
            data-days="7"
            style="display: block; height: 100%"
          ></a>
          <script>
            !(function (d, s, id) {
              var js,
                fjs = d.getElementsByTagName(s)[0];
              if (!d.getElementById(id)) {
                js = d.createElement(s);
                js.id = id;
                js.src = "https://weatherwidget.io/js/widget.min.js";
                fjs.parentNode.insertBefore(js, fjs);
              }
            })(document, "script", "weatherwidget-io-js");
          </script>
        </div>
      </div>
    </div>

    <!-- FOOTER -->
    <%- include('./partials/footer'); %> <%- include('./partials/scripts'); %>
  </body>
</html>
