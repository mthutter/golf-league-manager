<!doctype html>
<html lang="en">
  <head>
    <%- include('./partials/header'); %>
    <style>
      /* Ensure the main page structure fills the available vertical space between Navbar and Footer */
      html,
      body {
        height: 100%;
        margin: 0;
      }

      body {
        display: flex;
        flex-direction: column;
      }

      /* Force the main content area to expand and flexbox center its children */
      .main-wrapper {
        flex: 1 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* Centers header text and radar on X-axis */
        justify-content: center;
        /* Centers layout items vertically on Y-axis */
        padding: 2rem 1rem;
        box-sizing: border-box;
      }

      .gallery-header {
        text-align: center;
        margin-bottom: 1.5rem;
        /* Spacing between the text and the radar container */
      }

      /* =========================== CENTERED RADAR FRAME =========================== */
      .radar-outer-container {
        width: 100%;
        max-width: 800px;
        /* Max horizontal bounds for desktop view */
        height: 550px;
        /* Elevated height for the dedicated page slot */
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
        border: 2px solid #1b4332;
        /* Optional: Matched to your green golf league styling */
      }

      .radar-frame {
        width: 100%;
        height: 100%;
        border: none;
        display: block;
      }

      /* Ensure footer pushes down elegantly */
      footer {
        flex-shrink: 0;
      }

      /* =========================== WEEK MOVERS CARD =========================== */
      .movers-container {
        width: min(100%, 760px);
        margin: 0 auto;
        background: #fff;
        border: 2px solid #1b4332;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.12);
      }

      .movers-header {
        background: linear-gradient(135deg, #1b4332, #2d6a4f);
        color: #fff;
        text-align: center;
        padding: 0.85rem 1rem;
      }

      .movers-title {
        font-size: clamp(1rem, 2vw, 1.35rem);
        font-weight: 700;
        line-height: 1.3;
      }

      .movers-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        padding: 1rem;
      }

      .mover-panel {
        background: #f8faf8;
        border: 1px solid #d7e6d7;
        border-radius: 10px;
        padding: 0.85rem;
      }

      .panel-title {
        text-align: center;
        font-size: clamp(0.95rem, 1.4vw, 1.15rem);
        font-weight: 700;
        margin-bottom: 0.75rem;
        color: #1b4332;
      }

      .mover-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: clamp(0.35rem, 1vw, 0.6rem) 0;
        border-bottom: 1px solid #ececec;
      }

      .mover-row:last-child {
        border-bottom: none;
      }

      .mover-name {
        font-size: clamp(0.9rem, 1.1vw, 1.05rem);
        font-weight: 600;
        line-height: 1.25;
      }

      .trend-up,
      .trend-down {
        font-size: clamp(1rem, 1.1rem, 1.25rem);
        font-weight: 700;
        min-width: 3rem;
        text-align: right;
      }

      .trend-up {
        color: #198754;
      }

      .trend-down {
        color: #dc3545;
      }

      /* Responsive scaling for mobile devices */
      @media (max-width: 768px) {
        .movers-grid {
          gap: 0.75rem;
          padding: 0.75rem;
        }

        .mover-panel {
          padding: 0.75rem;
        }

        .radar-outer-container {
          height: 400px;
        }

        /* Shrinks map height on tablet displays */
      }

      @media (max-width: 576px) {
        .movers-grid {
          grid-template-columns: 1fr;
        }

        .movers-title {
          font-size: 1rem;
        }

        .panel-title {
          margin-bottom: 0.5rem;
        }

        .mover-row {
          padding: 0.45rem 0;
        }

        .radar-outer-container {
          height: 350px;
        }

        /* Shrinks map height further on small phones */
      }
    </style>
  </head>

  <body>
    <%- include('./partials/navbar'); %>

    <!-- MAIN VIEWPORT CONTAINER -->
    <div class="main-wrapper">
      <div class="gallery-header">
        <h1>Local Weather</h1>
        <p>Bottoms Up Golf League • 2026 Season</p>
      </div>

      <!-- Weather Radar Flex Wrapper -->
      <div class="radar-outer-container">
        <iframe
          class="radar-frame"
          src="https://embed.windy.com/embed2.html?lat=38.8576&lon=-104.7171&zoom=11&level=surface&overlay=radar&product=radar&menu=&message=true&marker=true&calendar=now&pressure=&type=map&location=coordinates&metricWind=mph&metricTemp=%C2%B0F&radarRange=-1"
          allowfullscreen
        >
        </iframe>
      </div>

      <div>
        <a class="weatherwidget-io" href="https://forecast7.com" data-label_1="COLORADO SPRINGS" data-label_2="WEATHER" data-theme="original"> COLORADO SPRINGS WEATHER </a>
        <script>
          !(function (d, s, id) {
            var js,
              fjs = d.getElementsByTagName(s)[0];
            if (!d.getElementById(id)) {
              js = d.createElement(s);
              js.id = id;
              js.src = "https://weatherwidget.io/js/widget.min.js";
              fjs.parentNode.insertBefore(js, fjs);
            }
          })(document, "script", "weatherwidget-io-js");
        </script>
      </div>
    </div>

    <!-- FOOTER -->
    <%- include('./partials/footer'); %> <%- include('./partials/scripts'); %>
  </body>
</html>
