<!doctype html>
<html lang="en">
  <head>
    <%- include('./partials/header'); %>
    <style>
      /* Ensure the main page structure fills the available vertical space between Navbar and Footer */
      html,
      body {
        height: 100%;
        margin: 0;
      }
      body {
        display: flex;
        flex-direction: column;
      }
      /* Force the main content area to expand and flexbox center its children */
      .main-wrapper {
        flex: 1 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        box-sizing: border-box;
      }
      .gallery-header {
        text-align: center;
        margin-bottom: 1.5rem;
      }

      /* =========================== DASHBOARD LAYOUT GRID =========================== */
      .weather-dashboard {
        display: flex;
        flex-direction: row;
        gap: 1.5rem;
        width: 100%;
        max-width: 1200px;
        align-items: stretch;
      }

      /* =========================== RADAR WINDOW =========================== */
      .radar-outer-container {
        flex: 1;
        height: 550px;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
        border: 2px solid #1b4332;
        position: relative;
      }

      .radar-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        background: rgba(27, 67, 50, 0.9); /* Solid dark golf green with slight transparency */
        color: #ffffff;
        padding: 0.5rem 0.85rem;
        border-radius: 6px;
        font-family: inherit;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        z-index: 5; /* Pushes the label in front of the map canvas */
        pointer-events: none; /* Allows users to click "through" the label onto the map map interface */
        border: 1px solid #2d6a4f;
      }

      .radar-frame {
        width: 100%;
        height: 100%;
        border: none;
        display: block;
      }

      /* =========================== WEATHER WIDGET SIDEBAR =========================== */
      .weather-widget-container {
        width: 100%;
        max-width: 300px; /* Snug desktop fit for the 300px widget */
        height: 550px;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
        border: 2px solid #1b4332;
        background: #67676c;
        position: relative;
        flex-shrink: 0;
      }

      /* =========================== RESPONSIVE BREAKPOINTS =========================== */
      /* For Tablets (landscape & portrait) and smaller laptops */
      @media (max-width: 992px) {
        .weather-dashboard {
          flex-direction: column; /* Shifts layout from side-by-side to stacked rows */
          align-items: center;
        }

        .radar-outer-container {
          width: 100%;
          max-width: 800px;
          height: 450px; /* Lowers map height so it doesn't take over tablet viewports */
        }

        .radar-badge {
          font-size: 0.75rem;
          top: 10px;
          left: 10px;
        }

        .weather-widget-container {
          width: 100%;
          max-width: 800px; /* Allows widget block to widen and fill row like the radar card */
          height: auto;
          min-height: 150px; /* Snaps weather back to standard horizontal ribbon profile */
        }
      }

      /* For Small Mobile Phones */
      @media (max-width: 576px) {
        .radar-outer-container {
          height: 350px; /* Shrinks map height further on compact screens */
        }
        .main-wrapper {
          padding: 1rem 0.5rem; /* Tightens white spacing padded around layout margins */
        }
      }
    </style>
  </head>
  <body>
    <%- include('./partials/navbar'); %>

    <!-- MAIN VIEWPORT CONTAINER -->
    <div class="main-wrapper">
      <div class="gallery-header">
        <h1>Local Weather</h1>
        <p>Bottoms Up Golf League • 2026 Season</p>
      </div>

      <!-- Combined Weather Layout Grid -->
      <div class="weather-dashboard">
        <!-- 1. Windy Radar Frame Container -->
        <div class="radar-outer-container">
          <div class="radar-badge">Cherokee Ridge Location</div>
          <iframe
            class="radar-frame"
            src="https://embed.windy.com/embed2.html?lat=38.8576&lon=-104.7171&zoom=11&level=surface&overlay=radar&product=radar&menu=&message=true&marker=true&calendar=now&pressure=&type=map&location=coordinates&metricWind=mph&metricTemp=%C2%B0F&radarRange=-1&detailLat=38.8576&detailLon=-104.7171&detail=true"
            allowfullscreen
          ></iframe>
        </div>

        <!-- 2. Weather Widget Container -->
        <!--  <div class="weather-widget-container" style="height: 550px"> 
          <a
            class="weatherwidget-io"
            href="https://forecast7.com/en/38d86n104d70/80915/"
            data-label_1="COLORADO SPRINGS"
