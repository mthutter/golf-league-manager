<!doctype html>
<html lang="en">

<head>
  <%- include('partials/header'); %>
  
</head>

<body>
  <%- include('partials/navbar'); %>
  <!-- Header Banner -->
  <div class="container">
    <div class="gallery-header">
      <h1>System Users</h1>
      <p>Bottoms Up Golf League • 2026 Season</p>
    </div>
  </div>
  <!-- Roster Management Dashboard Layout -->
  <div class="container my-4">
    <div class="card shadow-sm players-table-card">
      <div class="table-responsive">
        <table class="table table-bordered align-middle text-center mb-0 league-table table-hover">
          <thead>
            <tr>
              <th class="col-1">#</th>
              <th class="col-3">User</th>
              <th class="col-2">Roles</th>
              <th class="col-4">E-Mail</th>
              <% if (isAdmin) { %>
              <th class="col-2">Actions</th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <% let activeCount = 1; %>
            <% players.forEach(player => { if (player.is_non_member == 1) { %>
            <tr>
              <td class="fw-bold bg-light players-text">
                <%= activeCount++ %>
              </td>
              <td class="text-start fw-semibold players-text">
                <%= player.user %>
              </td>
              <!-- New Roles Column -->
              <td class="text-start players-text text-muted">
                <%= player.roles %>
              </td>
              <td class="players-text email-cell">
                <a href="mailto:<%= player.e_mail %>"><%= player.e_mail %></a>
              </td>
              <% if (isAdmin) { %>
              <td>
                <div class="action-cell">
                  <a href="/players/<%= player.id %>/edit" class="btn btn-sm btn-league-edit">
                    Edit
                  </a>
                </div>
              </td>
              <% } %>
            </tr>
            <% }}) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <%- include('partials/footer'); %>
  <%- include('partials/scripts'); %>

  <!-- PHONE NUMBER AUTO FORMATTER SCRIPT -->
  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const phoneLinks = document.querySelectorAll('.phone-link');

      phoneLinks.forEach(link => {
        let rawValue = link.textContent.replace(/\D/g, "");

        if (rawValue.length === 10) {
          link.textContent = `(${rawValue.slice(0, 3)}) ${rawValue.slice(3, 6)}-${rawValue.slice(6)}`;
        }
      });
    });
  </script>
</body>

</html>