<!doctype html>
<html lang="en">
  <head>
    <%- include('./partials/header'); %>
    <style>
      .blacklist-card {
        border: 1.5px solid rgba(220, 53, 69, 0.15);
        border-radius: 12px;
        overflow: hidden;
      }
      /* MINIMALIST COMPACT CELL PADDING AND WIDTHS */
      .table th,
      .table td {
        padding: 4px 6px !important;
        vertical-align: middle;
        white-space: nowrap;
      }
      .ip-badge {
        font-family: var(--bs-font-monospace);
        font-weight: 600;
        letter-spacing: -0.5px;
        display: inline-block;
      }
      .port-badge {
        font-family: var(--bs-font-monospace);
        font-weight: 500;
      }
      .form-control-custom {
        border: 1.5px solid rgba(0, 0, 0, 0.1);
        border-radius: 6px;
        transition: all 0.2s ease-in-out;
        font-size: 0.85rem;
      }
      .form-control-custom:focus {
        border-color: #dc3545;
        box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
      }

      /* 🟢 HEADER LAYOUT ALIGNMENT CONSTRAINTS */
      .header-position-wrapper {
        min-height: 90px;
      }
      .header-sidebar-card {
        border-radius: 12px;
        border: 1.5px solid rgba(0, 0, 0, 0.08);
        width: 340px;
      }

      @media (max-width: 991px) {
        .header-position-wrapper {
          min-height: auto;
          flex-direction: column-reverse;
          gap: 1.5rem;
        }
        .header-sidebar-card {
          width: 100%;
          position: static !important;
          transform: none !important;
        }
      }
    </style>
  </head>
  <body>
    <section>
      <%- include('./partials/navbar'); %>
    </section>

    <div class="container-fluid my-4 px-lg-5">
      <!-- 🟢 REORGANIZED LANDSCAPE CONTROL HEADER -->
      <div
        class="header-position-wrapper position-relative d-flex align-items-center justify-content-center mb-4"
      >
        <!-- Left Side Stack: Dynamic Header IP Input Card Form -->
        <div
          class="position-absolute start-0 top-50 translate-middle-y header-sidebar-card card shadow-sm bg-light"
        >
          <div class="card-body p-2 px-3">
            <form
              action="/admin/security/blacklist"
              method="POST"
              onsubmit="
                return confirm('Permanently block these network targets?');
              "
              class="d-flex align-items-center gap-2 mb-0"
            >
              <div class="flex-grow-1">
                <textarea
                  name="ipList"
                  class="form-control form-control-custom font-monospace py-1"
                  rows="1"
                  placeholder="Enter IP(s)..."
                  style="resize: none"
                  required
                ></textarea>
              </div>
              <div>
                <button
                  type="submit"
                  class="btn btn-sm btn-danger text-white shadow-sm fw-bold px-3 py-1 rounded-2"
                  style="font-size: 0.8rem; white-space: nowrap"
                >
                  Ban IP
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- Centered Header Banner Title text elements -->
        <div class="gallery-header text-center m-0">
          <h1 class="fs-2 fw-bold m-0">Active Firewall Blacklist</h1>
          <p class="text-muted small mb-0">Bottoms Up Golf League</p>
        </div>
      </div>

      <!-- Alert Flash Announcements -->
      <div class="row justify-content-center">
        <div class="col-12">
          <% if (typeof success !== 'undefined' && success.length > 0) { %>
          <div
            class="alert alert-success alert-dismissible fade show shadow-sm py-2 px-3 small"
            role="alert"
          >
            <strong>Success!</strong>
            <%= success %>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="alert"
            ></button>
          </div>
          <% } %>
          <% if (typeof error !== 'undefined' && error.length > 0) { %>
          <div
            class="alert alert-danger alert-dismissible fade show shadow-sm py-2 px-3 small"
            role="alert"
          >
            <strong>Error!</strong>
            <%= error %>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="alert"
            ></button>
          </div>
          <% } %>
        </div>
      </div>

      <!-- 🚀 FULL EXPANSION RENDER GRID ROW -->
      <div class="row">
        <div class="col-12">
          <div class="card shadow-sm blacklist-card border-0">
            <div class="table-responsive">
              <table
                class="table table-sm table-striped table-hover align-middle mb-0 text-center"
              >
                <thead class="table-dark">
                  <tr>
                    <th style="width: 15%">Target IP</th>
                    <th style="width: 8%">Strikes</th>
                    <th style="width: 8%">Port</th>
                    <th style="width: 22%">First Seen</th>
                    <th style="width: 22%">Latest Seen</th>
                    <th style="width: 15%">Ban Type</th>
                    <th style="width: 10%">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!bannedIps || bannedIps.length === 0) { %>
                  <tr>
                    <td colspan="7" class="py-4 text-muted">
                      <h5 class="fw-bold m-0" style="font-size: 0.9rem">
                        The IP firewall blacklist is clean
                      </h5>
                      <p class="small text-muted mb-0">
                        No network nodes are currently blocked.
                      </p>
                    </td>
                  </tr>
                  <% } else { %>
                  <% bannedIps.forEach(target => { %>
                  <tr>
                    <!-- IP Node Address -->
                    <td>
                      <span class="text-danger ip-badge small">
                        <%= target.ip %>
                      </span>
                    </td>

                    <!-- Offense Strikes Count Indicator -->
                    <td>
                      <span
                        class="badge <%= target.strikes >= 10 ? 'bg-danger' : 'bg-warning text-dark' %> px-2 py-1 small"
                      >
                        <%= target.strikes %>/10
                      </span>
                    </td>

                    <!-- Last Source Port Cell -->
                    <td>
                      <% if (target.last_source_port) { %>
                      <span
                        class="badge bg-secondary port-badge px-2 py-0 small"
                        style="font-size: 0.75rem"
                      >
                        <%= target.last_source_port %>
                      </span>
                      <% } else { %>
                      <span class="text-muted small">—</span>
                      <% } %>
                    </td>

                    <!-- Timestamps (Denver/Mountain Localization) -->
                    <td
                      class="small text-muted font-monospace"
                      style="font-size: 0.75rem"
                    >
                      <% if (target.first_seen) { %>
                      <%= new
                      Date(target.first_seen).toLocaleString("en-US", {
                      timeZone: "America/Denver", dateStyle: "short", timeStyle:
                      "short" }) %>
                      <% } else { %>
                      Manual
                      <% } %>
                    </td>
                    <td
                      class="small text-muted font-monospace"
                      style="font-size: 0.75rem"
                    >
                      <% if (target.last_seen) { %>
                      <%= new
                      Date(target.last_seen).toLocaleString("en-US", { timeZone:
                      "America/Denver", dateStyle: "short", timeStyle: "short"
                      }) %>
                      <% } else { %>
                      Manual
                      <% } %>
                    </td>

                    <!-- Ban Type Badge Indicator -->
                    <td>
                      <% if (target.manual_ban && (target.manual_ban == 1 || target.manual_ban === true || target.manual_ban == "1")) { %>
                      <span
                        class="badge bg-info text-dark px-2 py-0 small"
                        style="font-size: 0.75rem"
                        >Manual</span
                      >
                      <% } else { %>
                      <span
                        class="badge bg-secondary px-2 py-0 small"
                        style="font-size: 0.75rem"
                        >Auto</span
                      >
                      <% } %>
                    </td>

                    <!-- Lift Ban Action Endpoint Form -->
                    <td>
                      <form
                        action="/admin/security/blacklist/delete"
                        method="POST"
                        onsubmit="
                          return confirm(
                            'Restore structural access for <%= target.ip %>?',
                          );
                        "
                        class="m-0"
                      >
                        <input
                          type="hidden"
                          name="ip"
                          value="<%= target.ip %>"
                        />
                        <button
                          type="submit"
                          class="btn btn-xs btn-outline-success rounded px-2 py-0"
                          style="font-size: 0.7rem; line-height: 1.2"
                        >
                          Lift
                        </button>
                      </form>
                    </td>
                  </tr>
                  <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <section>
      <%- include('./partials/footer'); %>
    </section>
    <section>
      <%- include('./partials/scripts'); %>
    </section>
  </body>
</html>
