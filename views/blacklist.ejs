<!doctype html>
<html lang="en">
  <head>
    <%- include('./partials/header'); %>
    <style>
      .blacklist-card {
        border: 1.5px solid rgba(220, 53, 69, 0.15);
        border-radius: 16px;
        overflow: hidden;
      }
      .ip-badge {
        font-family: var(--bs-font-monospace);
        font-weight: 600;
        letter-spacing: -0.5px;
      }
      .port-badge {
        font-family: var(--bs-font-monospace);
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <section>
      <%- include('./partials/navbar'); %>
    </section>
    
    <div class="container my-4">
      <!-- Header Banner -->
      <div class="gallery-header text-center my-4">
        <h1>Active Firewall Blacklist</h1>
        <p>Bottoms Up Golf League</p>
      </div>

      <!-- Alert Flash System Announcements -->
      <div class="row justify-content-center">
        <div class="col-lg-10">
          <% if (typeof success !== 'undefined' && success.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
              <strong>Success!</strong> <%= success %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% } %>
          <% if (typeof error !== 'undefined' && error.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
              <strong>Error!</strong> <%= error %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Navigation Hub and Overview Metrics -->
      <div class="row justify-content-center mb-4">
        <div class="col-lg-10 d-flex justify-content-between align-items-center">
          <span class="badge bg-danger rounded-pill px-3 py-2 fs-6 shadow-sm">
            Active Blocks: <%= bannedIps.length %>
          </span>
        </div>
      </div>

      <!-- Main Blacklist Grid Matrix Roster -->
      <div class="row justify-content-center">
        <div class="col-lg-10">
          <div class="card shadow-sm blacklist-card">
            <div class="table-responsive">
              <table class="table table-striped table-hover align-middle mb-0 text-center">
                <thead class="table-dark">
                  <tr>
                    <th style="width: 15%">Target IP Node</th>
                    <th style="width: 10%">Strikes/Hits</th>
                    <th style="width: 10%">Last Port</th> <!-- ➕ ADDED: Column Header -->
                    <th style="width: 20%">First Strike</th>
                    <th style="width: 20%">Latest Strike</th>
                    <th style="width: 13%">Ban Type</th>
                    <th style="width: 12%">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!bannedIps || bannedIps.length === 0) { %>
                    <tr>
                      <td colspan="7" class="py-5 text-muted"> <!-- 🔄 UPDATED: Colspan from 6 to 7 -->
                        <h5 class="fw-bold m-0">The IP firewall blacklist is clean</h5>
                        <p class="small text-muted mb-0">No network nodes are currently blocked by the application.</p>
                      </td>
                    </tr>
                  <% } else { %>
                    <% bannedIps.forEach(target => { %>
                      <tr>
                        <!-- IP Node Address -->
                        <td class="text-center">
                          <span class="text-danger ip-badge fs-6">
                            <%= target.ip %>
                          </span>
                        </td>
                        
                        <!-- Offense Strikes Count Indicator -->
                        <td>
                          <span class="badge <%= target.strikes >= 10 ? 'bg-danger' : 'bg-warning text-dark' %> rounded-pill px-3">
                            <%= target.strikes %> / 10
                          </span>
                        </td>

                        <!-- ➕ ADDED: Last Source Port Cell -->
                        <td>
                          <% if (target.last_source_port) { %>
                            <span class="badge bg-secondary port-badge px-2 py-1 small">
                              <%= target.last_source_port %>
                            </span>
                          <% } else { %>
                            <span class="text-muted small">—</span>
                          <% } %>
                        </td>
                        
                        <!-- 🟢 TIMESTAMPS: Coerced to safely display in Denver time format strings -->
                        <td class="small text-muted font-monospace">
                          <% if (target.first_seen) { %>
                            <%= new Date(target.first_seen).toLocaleString("en-US", { timeZone: "America/Denver", dateStyle: "short", timeStyle: "short" }) %>
                          <% } else { %>
                            Manual Entry
                          <% } %>
                        </td>
                        
                        <td class="small text-muted font-monospace">
                          <% if (target.last_seen) { %>
                            <%= new Date(target.last_seen).toLocaleString("en-US", { timeZone: "America/Denver", dateStyle: "short", timeStyle: "short" }) %>
                          <% } else { %>
                            Manual Entry
                          <% } %>
                        </td>
                        
                        <!-- 🟢 BAN TYPE BUGFIX: Swapped assignment operator (=) for logical strict checking (===) -->
                        <td class="small text-muted font-monospace">
                          <%= Number(target.manual_ban) === 1 ? 'Manual Entry' : 'Auto Entry' %>
                        </td>
                        
                        <!-- Lift Ban Action Endpoint Form -->
                        <td>
                          <form action="/admin/security/blacklist/delete" method="POST" onsubmit="return confirm('Forcibly restore structural application access parameters for IP address <%= target.ip %>?');">
                            <input type="hidden" name="ip" value="<%= target.ip %>" />
                            <button type="submit" class="btn btn-xs btn-outline-success rounded-pill fw-bold py-1 px-3" style="font-size: 0.75rem">
                              Lift Ban
                            </button>
                          </form>
                        </td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <section>
      <%- include('./partials/footer'); %>
    </section>
    <section>
      <%- include('./partials/scripts'); %>
    </section>
  </body>
</html>
