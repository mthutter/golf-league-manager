<!doctype html>
<html lang="en">
  <head>
    <%- include('./partials/header'); %>
    
  </head>

  <body>
    <%- include('./partials/navbar'); %>

    <!-- Header Banner -->
    <div class="container">
      <div class="page-header">
        <h1>Week <%= weekId %> (<%= weekDate.displayDate %>) Results</h1>
        <p>Bottoms Up Golf League • 2026 Season</p>
      </div>
      <div class="week-nav mb-4">
        <a href="/scores/standings" class="button-link btn btn-light btn-sm">
          ← Back to Standings
        </a>
      </div>
    </div>
      <!-- Weekly Performance Dashboard Layout -->
    <div class="container my-4">
        <div class="card shadow-sm results-table-card">
            <div class="table-responsive" style="text-align: center">
                <table id="sortableTable" class="table table-bordered align-middle text-center mb-0 league-table compact-pixel-table table-hover">
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Player</th>
                            <th>Total Points</th>
                            <th>Gross Score</th>
                            <th>Net Score</th>
                            <th>Stableford Points</th>
                            <th>CTP Points</th>
                            <th>Birdie Points</th>
                            <% if (isAdmin) { %>
                            <th>Actions</th>
                            <% } %>
                        </tr>
                    </thead>
                    <tbody>
                        <% results.forEach((player, idx) => { %>
                        <tr>
                            <td class="fw-bold bg-light players"><%= idx + 1 %></td>
                            
                            <!-- 💡 FIXED: Uses player.id to link safely to your profile path without empty routes -->
                            <td class="text-start fw-semibold players nowrap-cell">
                                <a href="/scores/round/<%= player.score_id %>" class="player-link">
                                    <%= player.player_name %>
                                </a>
                            </td>
                            
                            <td class="fw-bold text-success pe-3 players nowrap-cell">
                                <strong><%= player.total_points %></strong>
                            </td>
                            <td class="players nowrap-cell"><%= player.gross_total %></td>
                            <td class="players nowrap-cell"><%= player.net_total %></td>
                            <td class="players nowrap-cell"> <%= player.stableford_total %> </td>
                            <td class="players nowrap-cell"><%= player.ctp_points %></td>
                            <td class="players nowrap-cell"><%= player.birdie_points %></td>
                            
                            <% if (isAdmin) { %>
                            <td class="players nowrap-cell">
                                <a href="/scores/edit/<%= player.score_id %>" class="btn btn-outline-primary btn-sm btn-modify">
                                    ✏️ Modify
                                </a>
                            </td>
                            <% } %>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include('./partials/footer'); %>
    <%- include('./partials/scripts'); %>
</body>

</html>
