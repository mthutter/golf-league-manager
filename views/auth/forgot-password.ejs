<!doctype html>
<html lang="en">
  <head>
    <%- include("../partials/header") %>
    <link href="/assets/css/auth.css" rel="stylesheet" />
  </head>

  <body>
    <%- include("../partials/navbar") %>

    <div id="custom-form" class="auth-wrapper">
      <div class="auth-card text-center">
        <div class="logo-icon"><img height="90px" width="90px" src="https://bottoms-up.b-cdn.net/bottoms-up-logo.png" alt="Bottoms Up Golf League" /></div>
        <div class="league-title">Bottoms Up Golf League</div>
        <div class="league-subtitle">Password Reset</div>

        <form method="post" action="/forgot-password">
          <div class="mb-3">
            <label>Email Address</label>
            <input type="email" name="email" class="form-control" required autocomplete="email" />
          </div>

          <button class="btn btn-primary">Send Reset Link</button>
        </form>
      </div>
    </div>
    <%- include("../partials/scripts") %> <%- include("../partials/footer") %>
  </body>
</html>
