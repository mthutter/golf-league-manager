<h2>Forgot Password</h2>

<form method="post" action="/forgot-password">
  <div class="mb-3">
    <label>Email Address</label>
    <input
      type="email"
      name="email"
      class="form-control"
      required
      autocomplete="email"
    />
  </div>

  <button class="btn btn-primary">Send Reset Link</button>
</form>
