<!doctype html>
<html lang="en">
  <head>
    <%- include("../partials/header") %>
    <link href="/assets/css/auth.css" rel="stylesheet" />
  </head>

  <body>
    <%- include("../partials/navbar") %>s

    <div class="auth-wrapper">
      <div class="auth-card text-center">
        <div class="logo-icon">⛳</div>
        <div class="league-title">Bottoms Up Golf League</div>
        <div class="league-subtitle">Password Reset</div>
        <form method="post" action="/reset-password">
          <input type="hidden" name="token" value="<%= token %>" />

          <div class="mb-3">
            <label>New Password</label>
            <input type="password" name="password" class="form-control" required autocomplete="new-password" />
          </div>

          <div class="mb-3">
            <label>Confirm Password</label>
            <input type="password" name="confirmPassword" class="form-control" required autocomplete="new-password" />
          </div>

          <button class="btn btn-primary">Reset Password</button>
        </form>
      </div>
    </div>
    <%- include("../partials/scripts") %> <%- include("../partials/footer") %>
  </body>
</html>
