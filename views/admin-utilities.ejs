<!doctype html> 
<html lang="en"> 
<head> 
  <%- include('./partials/header'); %> 
</head> 
<body> 
  <section> 
    <%- include('./partials/navbar'); %> 
  </section> 
  <div class="container my-4"> 
    <div class="gallery-header"> 
      <h1>Admin Tools</h1> 
      <p>Bottoms Up Golf League • 2026 Season</p> 
    </div> 

    <!-- Main Dashboard Header Navigation --> 
    <div class="d-flex justify-content-between align-items-center mb-4"> 
      <a href="/admin" class="btn btn-sm btn-secondary">Back to Dashboard</a> 
    </div> 

    <!-- Row 1: Calculation Engines Grid Matrix --> 
    <div class="row g-4 mb-4"> 
      <!-- Utility 1: Weekly Skins Processor --> 
      <div class="col-md-6"> 
        <div class="card shadow-sm h-100"> 
          <div class="card-header bg-success text-white"> 
            <h5 class="card-title mb-0">Weekly Skins Processor</h5> 
          </div> 
          <div class="card-body d-flex flex-column justify-content-between"> 
            <form method="POST" action="/admin/skins/calculate"> 
              <div class="mb-3"> 
                <label class="form-label fw-bold">Select Week</label> 
                <select name="weekId" class="form-select" required> 
                  <option value="">-- Choose Week --</option> 
                  <% for(let i = 1; i <= 22; i++) { %> 
                    <% if (typeof selectedWeek !== 'undefined' && selectedWeek === i) { %> 
                      <option value="<%= i %>" selected> Week <%= i %> </option> 
                    <% } else { %> 
                      <option value="<%= i %>">Week <%= i %></option> 
                    <% } %> 
                  <% } %> 
                </select> 
              </div> 
              <button type="submit" class="btn btn-success w-100"> Calculate & Save Skins </button> 
            </form> 
          </div> 
        </div> 
      </div> 

      <!-- Utility 2: Calculate Handicaps Engine --> 
      <div class="col-md-6"> 
        <div class="card shadow-sm h-100"> 
          <div class="card-header bg-primary text-white"> 
            <h5 class="card-title mb-0">Handicap Recalculation Engine</h5> 
          </div> 
          <div class="card-body d-flex flex-column justify-content-between"> 
            <form method="POST" action="/admin/handicaps/calculate"> 
              <p class="text-muted small mb-3"> 
                Recalculates player handicaps using all scores entered for the current season. 
              </p> 
              <button type="submit" class="btn btn-primary w-100"> Recalculate Player Handicaps </button> 
            </form> 
          </div> 
        </div> 
      </div> 
    </div>
    <!-- Row 2: Security Utilities Grid Block --> 
    <div class="row g-4 mb-4"> 
      <!-- Player Password Override Panel -->
      <div class="col-md-6"> 
        <div class="card shadow-sm h-100"> 
          <div class="card-header text-white fw-bold" style="background-color: #1b4332;"> 
            🔐 Player Password Override Utility 
          </div> 
          <div class="card-body bg-light text-dark d-flex flex-column justify-content-between"> 
            <form action="/admin/players/reset-password" method="POST" onsubmit="return confirm('Forcibly alter this member\'s account credentials? All current active sessions for this player will be terminated.');"> 
              <p class="text-muted small mb-3"> Directly overwrite a player's login password. This updates their access token hash in SQLite immediately without requiring confirmation emails. </p>
              <div class="mb-3"> 
                <label class="form-label fw-semibold small">Select League Player</label> 
                <select name="memberId" class="form-select form-select-sm" required> 
                  <option value="">-- Choose Roster Target --</option> 
                  <% if (locals.members) { members.forEach(p => { %> 
                    <option value="<%= p.id %>"><%= p.name_last %>, <%= p.name_first %></option> 
                  <% }) } %> 
                </select> 
              </div> 
              <div class="mb-3"> 
                <label class="form-label fw-semibold small">New Temporary Password</label> 
                <div class="input-group input-group-sm"> 
                  <input type="text" name="newPassword" class="form-control" placeholder="Type password or hit generate..." required minlength="6" /> 
                  <button type="button" class="btn btn-outline-secondary" onclick="this.previousElementSibling.value = Math.random().toString(36).slice(-8)"> 🎲 Generate </button> 
                </div> 
              </div> 
              <button type="submit" class="btn btn-sm text-white fw-bold w-100 py-2" style="background-color: #1b4332; border: none;"> Apply Override Updates </button> 
            </form> 
          </div> 
        </div> 
      </div> 

      <!-- Bulk IP Blacklist Panel -->
      <div class="col-md-6">
        <div class="card shadow-sm h-100">
          <div class="card-header bg-danger text-white fw-bold">
            🚫 Bulk IP Firewall Blacklist
          </div>
          <div class="card-body bg-light text-dark d-flex flex-column justify-content-between">
            <form action="/admin/security/blacklist" method="POST" onsubmit="return confirm('Are you sure you want to permanently blacklist these target IP addresses across the system?');">
              <p class="text-muted small mb-3">
                Manually append IP nodes straight into the persistent SQLite firewall block list cache. Dropping IPs here rejects their traffic at the threshold layer.
              </p>
              <div class="mb-3">
                <label class="form-label fw-semibold small">Target IP Addresses</label>
                <textarea name="ipList" class="form-control form-control-sm font-monospace" rows="4" placeholder="Enter one IP per line&#10;e.g.&#10;192.0.2.1&#10;203.0.113.5" required></textarea>
                <div class="form-text text-muted extra-small" style="font-size: 0.75rem;">
                  Accepts newlines, commas, or spaces as valid delimiters.
                </div>
              </div>
              <button type="submit" class="btn btn-sm btn-danger fw-bold w-100 py-2">
                Commit Permanent Block List
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
    <!-- Dynamic Results Presentation Section --> 
    <% if (typeof results !== 'undefined' && results !== null) { %> 
      <div class="card shadow-sm mb-4"> 
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center"> 
          <h5 class="mb-0">Calculated Payouts: Week <%= selectedWeek %></h5> 
          <span class="badge bg-success fs-6">Total Pot: $<%= Number(results.totalPot).toFixed(2) %></span> 
        </div> 
        <div class="card-body"> 
          <div class="table-responsive"> 
            <table class="table table-striped table-hover align-middle"> 
              <thead class="table-light"> 
                <tr> 
                  <th>Player Name</th> 
                  <th>Holes Claimed</th> 
                  <th class="text-center">Skins Total</th> 
                  <th class="text-end">Calculated Earnings</th> 
                </tr> 
              </thead> 
              <tbody> 
                <% if (!results.leaderboard || results.leaderboard.length === 0) { %> 
                  <tr> 
                    <td colspan="4" class="text-center py-4 text-muted"> 
                      No unique skins claimed for Week <%= selectedWeek %>. All holes tied or data is missing. 
                    </td> 
                  </tr> 
                <% } else { %> 
                  <% results.leaderboard.forEach(winner => { %> 
                    <% let itemsToRender = []; 
                       if (results.holeDetails && Array.isArray(results.holeDetails)) { 
                         const playerWins = results.holeDetails.filter(d => Number(d.member_id) === Number(winner.member_id)); 
                         playerWins.forEach(w => { 
                           const hNum = Number(w.hole_number); 
                           const totalWinnersForHole = results.holeDetails.filter(d => Number(d.hole_number) === hNum).length; 
                           const holeBaseValue = results.holePayouts ? results.holePayouts[hNum] : 0; 
                           const absoluteShare = holeBaseValue / (totalWinnersForHole || 1); 
                           if (totalWinnersForHole > 1) { 
                             itemsToRender.push(`Hole ${hNum} (Split • $${Math.round(absoluteShare)})`); 
                           } else { 
                             itemsToRender.push(`Hole ${hNum} ($${Math.round(absoluteShare)})`); 
                           } 
                         }); 
                       } 
                       const holesText = itemsToRender.length > 0 ? itemsToRender.join(', ') : 'None'; 
                       const formattedSkins = Number(winner.skins_won).toFixed(1).replace('.0', ''); %> 
                    <tr> 
                      <td> 
                        <div class="fw-bold"> <%= winner.name_first %> <%= winner.name_last %> </div> 
                      </td> 
                      <td> <%= holesText %> </td> 
                      <td class="text-center"> 
                        <span class="badge bg-secondary rounded-pill px-3"> <%= formattedSkins %> </span> 
                      </td> 
                      <td class="text-end text-success fw-bold"> $<%= Number(winner.payout).toFixed(2) %> </td> 
                    </tr> 
                  <% }); %> 
                <% } %> 
              </tbody> 
            </table> 
          </div> 
        </div> 
      </div> 
    <% } %> 
  </div> 

  <!-- Global Action Notification Toast Elements -->
  <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100"> 
    <div id="handicapToast" class="toast align-items-center text-white bg-primary border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000"> 
      <div class="d-flex"> 
        <div class="toast-body d-flex align-items-center gap-2"> 
          <div class="spinner-grow spinner-grow-sm text-light" role="status"></div> 
          <span><strong>Success!</strong> Player handicaps have been completely recalculated.</span> 
        </div> 
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button> 
      </div> 
    </div> 
  </div> 

  <section> 
    <%- include('./partials/footer'); %> 
  </section> 
  <section> 
    <%- include('./partials/scripts'); %> 
  </section> 
  
  <!-- Interactive Trigger Scripts -->
  <script> 
    document.addEventListener("DOMContentLoaded", function() { 
      const showPopup = "<%= typeof showHandicapPopup !== 'undefined' && showHandicapPopup ? 'true' : 'false' %>"; 
      if (showPopup === "true") { 
        const toastElement = document.getElementById("handicapToast"); 
        if (toastElement && typeof bootstrap !== "undefined") { 
          const bootstrapToast = new bootstrap.Toast(toastElement); 
          bootstrapToast.show(); 
        } 
      } 
    }); 
  </script> 
</body> 
</html>
